+ wire [23:0] deviation=cross_value[24]?-cross_value:cross_value;
+ wire [23:0] limit=tolerance*seg_dy;
+ wire wrong_turn=side?(cross_value< -$signed({1'b0,limit})):(cross_value>$signed({1'b0,limit}));
